# Хуулж .env нэртэй файл үүсгээд бодит утгаа оруулна. .env-г git-д хэзээ ч бүү оруул.

PORT=8000

# Админ панелийн нууц үг (8+ тэмдэгт). Хоосон бол /admin.html ажиллахгүй.
ADMIN_PASSWORD=

# Бараа, захиалга, зураг хадгалах хавтас (анхдагч: ./data). Байнгын диск рүү заана.
# DATA_DIR=/var/lib/lotus-data

# Сайтын нийтийн хаяг — QPay callback болон Голомтын буцах хаяг үүнээс үүснэ (https шаардлагатай)
PUBLIC_URL=https://lotusflowercraft.mn

# QPay Merchant v2 — гэрээ байгуулсны дараа QPay-аас (support@qpay.mn) авна.
# Туршилт: https://merchant-sandbox.qpay.mn, Бодит: https://merchant.qpay.mn
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=

# Голомт банк e-commerce (Visa/Mastercard/UnionPay + SocialPay) — merchant@golomtbank.com
GOLOMT_BASE_URL=https://ecommerce.golomtbank.com
GOLOMT_TOKEN=
GOLOMT_SECRET=

# Telegram мэдэгдэл (заавал биш) — шинэ захиалга, төлбөр орох үед
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
